; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HexaRhythm"
config/description="6-lane rhythm game driven by AI-generated audio charts."
config/version="0.1.0"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.06, 0.06, 0.1, 1)
config/icon="res://assets/textures/icon.svg"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[autoload]

GameConfig="*res://scripts/core/GameConfig.gd"
GameStateManager="*res://scripts/core/GameStateManager.gd"
GameController="*res://scripts/core/GameController.gd"
ChartLoader="*res://scripts/ChartLoader.gd"
AudioSync="*res://scripts/AudioSync.gd"
ScoreManager="*res://scripts/ScoreManager.gd"
AudioFeedback="*res://scripts/systems/AudioFeedback.gd"
OffsetCalibration="*res://scripts/OffsetCalibration.gd"
PlayerProfile="*res://scripts/systems/PlayerProfile.gd"
SettingsManager="*res://scripts/systems/SettingsManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

tap={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.04, 0.04, 0.08, 1)
